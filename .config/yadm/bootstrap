#!/bin/sh

system_type=$(uname -s)

DIVIDER="\n----------------------------------------------------------------------------"
DIR=$(dirname -- "${BASH_SOURCE[0]}")

# XDG Base Directory - needed for brew bundle --global
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

echo "[YADM] Running bootstrap from $0"

if ! which brew > /dev/null; then
  echo "[YADM] Homebrew is not installed, exiting..."
  exit 1
fi

echo "${DIVIDER}\n[YADM] Updating homebrew bundle"
brew bundle --global

# if [ -d "$HOME/.iterm2" ]; then
#   echo "[YADM] iTerm setup"
#   defaults write com.googlecode.iterm2 PrefsCustomFolder "$HOME/.iterm2"
# fi

if which bat >/dev/null; then
  echo "${DIVIDER}\n[YADM] Installing bat syntax themes"
  BAT_THEMES_DIR="$(bat --config-dir)/themes"
  mkdir -p "$BAT_THEMES_DIR"
  for theme in tokyonight_moon tokyonight_day; do
    curl -fsSL -o "$BAT_THEMES_DIR/$theme.tmTheme" \
      "https://raw.githubusercontent.com/folke/tokyonight.nvim/main/extras/sublime/$theme.tmTheme" \
      || echo "[YADM] WARNING: failed to download bat theme '$theme'"
  done
  bat cache --build
  bat --list-themes | grep -qx tokyonight_moon \
    || echo "[YADM] WARNING: bat theme 'tokyonight_moon' missing after cache build (bat will warn and fall back to default)"
fi

if [ ! -d ~/.config/tmux/plugins/tpm ]; then
  echo "${DIVIDER}\n[YADM] Tmux setup"
  git clone --depth 1 https://github.com/tmux-plugins/tpm ~/.config/tmux/plugins/tpm
fi

if which mise >/dev/null; then
  echo "${DIVIDER}\n[YADM] Installing tools via mise (https://mise.jdx.dev)"
  mise trust ~/.config/mise/config.toml
  mise install
fi

if ! which claude >/dev/null; then
  echo "${DIVIDER}\n[YADM] Installing Claude Code CLI"
  curl -fsSL https://claude.ai/install.sh | sh
fi

if which claude >/dev/null; then
  echo "${DIVIDER}\n[YADM] Setting up Claude Code plugins"
  claude plugin marketplace add rsmdt/the-startup
  claude plugin install team@the-startup
  claude plugin install start@the-startup
  claude plugin install frontend-design@claude-plugins-official
  claude plugin install greptile@claude-plugins-official
fi

if which herdr >/dev/null; then
  echo "${DIVIDER}\n[YADM] Setting up Herdr plugins"
  herdr plugin install -y paulbkim-dev/vim-herdr-navigation
fi

# if which nvim > /dev/null; then
#   echo "[YADM] NeoVim setup"
#   nvim '+PlugUpdate' '+PlugClean' '+qa'
# fi

echo "${DIVIDER}\n[YADM] Spotlight"
cat $DIR/DISABLE_SPOTLIGHT.txt
read -p "[YADM] Do you wish to disable Spotlight indexing? [N/y] " disableSpotlight
disableSpotlight="${disableSpotlight}:=n"
case $disableSpotlight in
  [Yy]* )
    sudo mdutil -a -i off
    ;;
  * ) echo "Skipping...";;
esac

echo "\n[YADM] done."
